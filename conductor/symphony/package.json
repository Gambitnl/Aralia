{
  "name": "symphony",
  "version": "0.1.0",
  "description": "TypeScript implementation of OpenAI Symphony — autonomous coding agent orchestrator",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "verify:jules-contract": "npm run build && node scripts/run-all-verifiers.mjs",
    "verify:queue": "npm run build && node scripts/verify-queue-next-action.mjs",
    "start": "tsx src/index.ts",
    "dev": "tsx --watch src/index.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "js-yaml": "^4.3.1",
    "liquidjs": "^10.27.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "tsx": "^4.23.9",
    "typescript": "~5.9.3"
  }
}
