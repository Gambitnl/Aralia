# Design Preview Tool (local-only developer tool)
#
# 2026-08-28: four files left this folder because GAME code imported them,
# which is what forced them into git in the first place. waterSheet.ts went
# to BattleMap/terrain, PreviewBuilding3D to devtools/buildingIdentityLab,
# PreviewMdLibrary (+ docLibrary) to devtools/mdLibrary, and
# PreviewSpellDataFlow to devtools/spellPipeline. A preview may import game
# code; game code must never import a preview.
src/components/DesignPreview/
!src/components/DesignPreview/
src/components/DesignPreview/*
!src/components/DesignPreview/steps/
src/components/DesignPreview/steps/*
# The ocean viewer: git keeps it (Water and Land sheet, round 18, q26,
# 2026-09-28). Every ocean gauntlet piece is filmed and judged through these
# files; they import only each other and tracked ocean modules. The other
# side-by-side previews in this folder stay ignored.
!src/components/DesignPreview/steps/sidebyside/
src/components/DesignPreview/steps/sidebyside/*
!src/components/DesignPreview/steps/sidebyside/SideBySideOcean.tsx
!src/components/DesignPreview/steps/sidebyside/ComparePane.tsx
!src/components/DesignPreview/steps/sidebyside/oceanExtras.ts
!src/components/DesignPreview/steps/sidebyside/oceanFreeLook.ts
!src/components/DesignPreview/steps/sidebyside/oceanExtras/
!src/components/DesignPreview/steps/sidebyside/oceanExtras/**
!src/components/DesignPreview/steps/PreviewDungeon.tsx
# The World Battle Lab is a canonical Vistest/debug contract, not a local-only
# preview experiment; keep this one scenario harness in shared history.
!src/components/DesignPreview/steps/PreviewBattleMapScenarioLab.tsx
# The shared Tactical Sandbox domain-tab shell is an intentional cross-domain
# contract, so keep its source and focused proof visible despite the local-only
# Design Preview default above.
!src/components/DesignPreview/steps/PreviewCombatDomainTabs.tsx
!src/components/DesignPreview/steps/PreviewCombatDomainTabs.test.tsx
# These three folders are the durable, self-contained domain panels registered
# by the shared Tactical Sandbox shell. Their internals stay owned by the peer
# domain lanes while the central host imports only each folder's public export.
!src/components/DesignPreview/steps/classes/
!src/components/DesignPreview/steps/classes/**
!src/components/DesignPreview/steps/raceDomain/
!src/components/DesignPreview/steps/raceDomain/**
