{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "vitest/globals",
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.ts",
    "src/**/*",
    "devtools/roadmap/src/components/debug/roadmap/modules/roadmap-history-traceability.ts",
    "devtools/roadmap/scripts/roadmap-server-logic.ts",
    "devtools/roadmap/scripts/roadmap-engine/**/*.ts",
    "devtools/roadmap/scripts/roadmap/**/*.ts"
  ]
}
